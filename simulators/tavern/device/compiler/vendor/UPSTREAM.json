  "patch": "rustc_codegen_nvvm/src/ty.rs: bypass obsolete typed-fat-pointer field projection only for LLVM21 opaque-pointer ABI",
  "patched_file_sha256": "6bccc3018216095acd7884d7f84eeb9d487c25e2b1b553c9a3b9f36efe677377",
  "allocator_patch": "cuda_std/src/mem.rs: optional external-allocator feature disables SDK global allocator, retaining its malloc/free APIs; complete game allocations use reusable per-lane arenas with explicit CUDA spill fallback.",
  "anonymous_libm_patch": "rustc_codegen_nvvm/src/override_fns.rs: use opt_item_name and retain normal codegen for anonymous closures; named override behavior unchanged.",
